{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "fishpond",
  "version": "0.1.0",
  "identifier": "com.fishpond.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小鱼塘",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"]
  }
}
